{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "// tenant": "멀티테넌트(2026-10-03): 사이트(sy_site.site_id)·모듈은 tenant.mjs 인자, 환경파일은 프로파일별 .env.local/.env.development/.env.production 하나. 모듈 3개 = ec1(사이트 …01) · ec2(…02) · danmoo1(…03)",
    "tenant": "node scripts/tenant.mjs",
    "local": "node scripts/tenant.mjs dev --site 2604010000000001 --module ec1 --profile local",
    "local:ec2": "node scripts/tenant.mjs dev --site 2604010000000002 --module ec2 --profile local",
    "local:danmoo1": "node scripts/tenant.mjs dev --site 2604010000000003 --module danmoo1 --profile local",
    "dev": "node scripts/tenant.mjs dev --site 2604010000000001 --module ec1 --profile development",
    "dev:ec2": "node scripts/tenant.mjs dev --site 2604010000000002 --module ec2 --profile development",
    "dev:danmoo1": "node scripts/tenant.mjs dev --site 2604010000000003 --module danmoo1 --profile development",
    "build": "node scripts/tenant.mjs build --site 2604010000000001 --module ec1 --profile production",
    "build:ec2": "node scripts/tenant.mjs build --site 2604010000000002 --module ec2 --profile production",
    "build:danmoo1": "node scripts/tenant.mjs build --site 2604010000000003 --module danmoo1 --profile production",
    "build:dev": "node scripts/tenant.mjs build --site 2604010000000001 --module ec1 --profile development",
    "build:dev:ec2": "node scripts/tenant.mjs build --site 2604010000000002 --module ec2 --profile development",
    "build:dev:danmoo1": "node scripts/tenant.mjs build --site 2604010000000003 --module danmoo1 --profile development",
    "build:local": "node scripts/tenant.mjs build --site 2604010000000001 --module ec1 --profile local",
    "preview": "node scripts/tenant.mjs preview --site 2604010000000001 --module ec1 --profile production",
    "preview:dev": "node scripts/tenant.mjs preview --site 2604010000000001 --module ec1 --profile development",
    "generate": "nuxt generate",
    "typecheck": "cross-env NUXT_PUBLIC_TENANT_MODULE=ec1 nuxt typecheck",
    "typecheck:ec2": "cross-env NUXT_PUBLIC_TENANT_MODULE=ec2 nuxt typecheck",
    "typecheck:danmoo1": "cross-env NUXT_PUBLIC_TENANT_MODULE=danmoo1 nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "// postinstallGuide": "postinstall = nuxt prepare (.nuxt/ 타입선언+빌드캐시 생성, pnpm install 직후 자동 실행 — vue-tsc/typecheck가 이 캐시를 바로 써야 해서 필수). 배포 스크립트는 z0scripts/scripts_deploy_illeesam_{synol,netlify,github}/ 로 이동(2026-09-19).",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "consola": "^3.4.2",
    "cross-env": "^10.1.0",
    "netlify-cli": "^27.5.1",
    "nodemailer": "^10.0.9",
    "nuxt": "^4.3.1",
    "source-map": "^0.7.6",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@pinia/nuxt": "^0.11.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vueform/slider": "^2.1.7",
    "@yeger/vue-masonry-wall": "^3.4.4",
    "axios": "^1.20.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pinia": "^3.0.4",
    "sass": "^1.104.1",
    "vee-validate": "^4.7.4",
    "vue3-carousel": "^0.2.11",
    "vue3-toastify": "^0.1.1",
    "yup": "^1.0.2"
  },
  "overrides": {
    "@koa/router": "^15.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "netlify-cli",
      "sharp",
      "unix-dgram"
    ]
  },
  "// pnpmOnlyBuiltDependenciesGuide": "2026-09-13: pnpm 10부터 devDependencies의 postinstall/install 스크립트를 기본 차단(보안)한다 — esbuild는 그 스크립트로 자기 버전에 맞는 네이티브 바이너리를 받는데, 차단되면 호스트(JS)와 바이너리 버전이 어긋나 빌드가 'Host version X does not match binary version Y'로 깨진다(node-linker=hoisted 전환 후 재설치하며 실제로 겪음). 이 목록의 패키지들만 명시적으로 스크립트 실행을 허용."
}
