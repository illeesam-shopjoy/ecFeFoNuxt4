{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "local": "nuxt dev --dotenv .env.local",
    "dev": "nuxt dev",
    "dev:local": "nuxt dev --dotenv .env.local",
    "dev:prod": "nuxt dev --dotenv .env.production",
    "build": "nuxt build",
    "build:local": "nuxt build --dotenv .env.local",
    "build:dev": "nuxt build --dotenv .env.development",
    "build:prod": "nuxt build --dotenv .env.production",
    "preview": "nuxt preview",
    "preview:local": "nuxt preview --dotenv .env.local",
    "preview:dev": "nuxt preview --dotenv .env.development",
    "preview:prod": "nuxt preview --dotenv .env.production",
    "generate": "nuxt generate",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "---------- ■ netlify 배포 ----------": "exit 0",
    "build:netlify": "cross-env NETLIFY=true NITRO_PRESET=netlify nuxt build",
    "deploy": "npm run build:netlify && netlify deploy --prod --no-build --dir=dist --functions=.netlify/functions-internal --site=a1b4e768-a8ea-4430-a224-5a09d67971dc",
    "deploy:draft": "npm run build:netlify && netlify deploy --no-build --dir=dist --functions=.netlify/functions-internal --site=a1b4e768-a8ea-4430-a224-5a09d67971dc"
  },
  "// deployGuide": "deploy/deploy:draft 는 GitHub Actions(.github/workflows/netlify-deploy.yml)를 거치지 않고 이 PC에서 곧바로 netlify-cli로 배포한다. --no-build 는 netlify-cli가 원격 빌드 파이프라인(Netlify Build)을 다시 돌리는 것만 막아준다 — 그게 없으면 그 파이프라인이 내부적으로 'pnpm run build'를 다시 실행하려다 PATH에 pnpm이 없어 100% 실패한다. ⚠️ 그와 별개로, Windows에서 pnpm이 쓰는 심볼릭링크를 Nitro netlify 프리셋이 함수 폴더로 복사하는 과정이 간헐적으로 깨져(2026-09-09 실측, 재현 불규칙) 배포는 성공해도 실제 함수가 'Cannot find package' 500 에러를 낼 수 있다 — 정식/신뢰 가능한 배포 경로는 여전히 GitHub Actions(Linux 러너)다. 이 스크립트는 화면 확인용 빠른 임시 배포로만 쓰고, 정식 배포는 git push(main)로 GitHub Actions를 타게 할 것. deploy=운영(--prod), deploy:draft=미리보기 URL만 생성(운영 미반영). 최초 1회는 `netlify login`으로 이 PC에 Netlify 인증이 돼 있어야 한다.",
  "devDependencies": {
    "@types/node": "^20.19.0",
    "consola": "^3.4.2",
    "cross-env": "^10.1.0",
    "netlify-cli": "^27.5.1",
    "nuxt": "^4.2.2",
    "source-map": "^0.7.6",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@pinia/nuxt": "^0.11.3",
    "@vueform/slider": "^2.1.7",
    "@yeger/vue-masonry-wall": "^3.4.4",
    "axios": "^1.13.6",
    "chart.js": "^4.5.1",
    "pinia": "^3.0.4",
    "redis": "^4.7.1",
    "sass": "^1.58.3",
    "vee-validate": "^4.7.4",
    "vue3-carousel": "^0.2.11",
    "vue3-toastify": "^0.1.1",
    "yup": "^1.0.2"
  },
  "overrides": {
    "@koa/router": "^15.0.0"
  }
}
