# 이 프로젝트는 3개 실제 환경변수 파일을 쓴다(전부 git 미추적 — 아래 내용을 복사해 채울 것):
#   .env.local        로컬 PC 구동 (pnpm run dev:local / build:local)
#   .env.development   개발 배포, Synology NAS (pnpm run dev:prod* / build:dev)
#   .env.production    운영 배포, Netlify   (pnpm run build:prod)
# 3환경 모두 백엔드는 동일한 Synology NAS의 ecBeBo를 그대로 호출한다(BFF 방식 — 이
# 프로젝트는 DB에 직접 접속하지 않는다, server/utils/beApi.ts 참조). DATABASE_URL은
# 더 이상 쓰지 않음(2026-09 BFF 전환으로 Prisma 제거).

# ecBeBo API 서버 + ecBeCdn(이미지/동영상) — 3환경 공통값
NUXT_API_BASE_URL=https://22300.illeesam.synology.me
NUXT_PUBLIC_PROD_CDN_BASE=https://22400.illeesam.synology.me/api/cdn

# 환경 표시용 (로그/헤더에 노출) — local | development | production
NUXT_PUBLIC_MODE=local
NUXT_PUBLIC_ENV_NM=.env.local

# 토스페이먼츠 (테스트: test_ck_/test_sk_, 실서비스: live_ck_/live_sk_)
# NUXT_PUBLIC_TOSSPAYMENTS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TOSSPAYMENTS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 (README_GA4.md 참고)
# NUXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Redis (README_login_redis.md 참고)
# USE_REDIS=false
# REDIS_URL=redis://localhost:6379
# AUTH_JWT_SECRET=
# AUTH_ACCESS_TOKEN_TTL_MINUTES=15
# AUTH_REFRESH_TOKEN_TTL_DAYS=7

# 소셜 로그인 (각 README_login_OOO.md 참고)
# GOOGLE_CLIENT_ID= xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# APPLE_CLIENT_ID= ... .appleid
# APPLE_TEAM_ID= APPLE_KEY_ID= APPLE_PRIVATE_KEY=
