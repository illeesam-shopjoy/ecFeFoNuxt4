# 2026-09-13(진짜 원인 확정): "netlify deploy" 후 100% 재현되던
# `Error [ERR_MODULE_NOT_FOUND]: Cannot find package 'vue'` 운영장애의 근본 원인은
# Windows 경로가 아니라 — pnpm의 기본 node_modules 구조(심볼릭 링크 기반 content-addressable
# store) 자체였다. Nitro의 netlify 프리셋이 vue 등의 패키지를 자체 .nitro/<pkg>@<ver> 폴더로
# 옮기고 node_modules/vue를 그 절대경로를 가리키는 심볼릭 링크로 남기는데, Netlify 함수
# 패키징(zip-it-and-ship-it) 과정에서 그 심볼릭 링크의 실제 대상이 함수 번들 안에 제대로
# 포함되지 않아 Lambda(Linux)에서도, GitHub Actions(Linux CI)에서 빌드해도 동일하게 깨졌다
# (Windows 전용 문제가 아니었음 — 로컬/CI 둘 다 pnpm 기본 구조를 썼기 때문에 둘 다 재현됨).
#
# node-linker=hoisted 로 pnpm이 npm/yarn-classic처럼 실제 파일을 node_modules에 그대로
# 복사(비-심볼릭)하도록 강제 — Nitro가 vue를 다시 옮기더라도 원본이 심볼릭 링크가 아니므로
# 정상적으로 실제 디렉터리가 옮겨지고 패키징도 깨지지 않는다.
node-linker=hoisted

# pnpm 전용 옵션 제거됨 (shamefully-hoist, strict-peer-dependencies)
# npm 사용 시 이 파일은 비워 두거나 필요 시 legacy-peer-deps=true 추가
