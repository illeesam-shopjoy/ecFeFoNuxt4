# scripts/deploy-sites.mjs(= "github deploy <site>")가 로컬에서 읽는 배포용 비밀 설정.
# 이 예시를 복사해 저장소 루트에 .env.deploy 로 저장할 것 — 이 파일 자체는 .gitignore
# 처리되어 커밋되지 않는다. 값이 없으면 해당 기능(빌드결과 확인/이메일 통지)만 조용히
# 스킵되고 push 자체는 정상 진행된다(scripts/deploy-sites.mjs 상단 주석 참조).
# 2026-09-15(요청사항: ".env.production.example / .env.deploy.example 에 설정하는곳의
# url 링크정보도 넣어줘") — 이전엔 이 파일이 실수로 .env.production.example과 동일한
# 내용(앱 런타임용 값)으로 채워져 있었다 — 실제 이 스크립트가 읽는 키로 바로잡음.

# Netlify 배포결과 확인용 — 없으면 push까지만 하고 "대시보드에서 직접 확인" 안내만 남김.
# 설정: https://app.netlify.com/user/applications#personal-access-tokens →
# "New access token" (illeesam 팀 소속 4개 사이트: shopjoy-ecfefonuxt4/ecfemain/ecfebo/
# illeesam을 전부 볼 수 있는 계정으로 발급해야 4곳 모두 조회 가능).
NETLIFY_AUTH_TOKEN=

# 배포 결과 이메일 통지 (선택) — 발신 Gmail 계정과 그 계정의 "앱 비밀번호"(일반 로그인
# 비밀번호 아님). 설정: https://myaccount.google.com/apppasswords 에서 2단계 인증을 켠
# 뒤 앱 비밀번호를 새로 발급받아 NOTIFY_EMAIL_APP_PASSWORD에 넣는다.
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_APP_PASSWORD=
# 생략 시 기본값 illeesam@gmail.com 로 발송됨(사용자 요청, 2026-09-12).
NOTIFY_EMAIL_TO=
