# .env.deploy.example — scripts/deploy-sites.mjs 전용 로컬 비밀 설정 템플릿.
# 사용법: 이 파일을 .env.deploy 로 복사한 뒤 아래 값을 채운다. .env.deploy 는 .gitignore 처리되어
# 절대 커밋되지 않는다(이 .example 파일만 커밋됨).
#
# 값이 비어 있으면 scripts/deploy-sites.mjs 는 해당 기능만 조용히 건너뛴다(push는 항상 수행됨):
#   NETLIFY_AUTH_TOKEN 없음        → Netlify 네이티브 auto-build 3사이트의 실제 빌드결과 확인 스킵
#   NOTIFY_EMAIL_FROM/APP_PASSWORD 없음 → 결과 이메일 발송 스킵

# Netlify Personal Access Token — app.netlify.com → User settings → Applications → New access token
# (illeesam 팀의 4개 사이트를 모두 볼 수 있는 계정으로 발급할 것)
NETLIFY_AUTH_TOKEN=

# 결과 통지 이메일 발신 Gmail 계정 + 앱 비밀번호(일반 로그인 비밀번호 아님 — Google 계정 설정에서 발급)
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_APP_PASSWORD=

# 결과 통지 수신 이메일 — 생략하면 illeesam@gmail.com 기본값
NOTIFY_EMAIL_TO=illeesam@gmail.com

# ──────────────────────────────────────────────────────────────────────────
# 2026-09-14: 아래부터는 scripts/deploy-sites.mjs도 Nuxt 앱도 이 파일에서 읽지 않는
# 참고용 값(사용자 확인 후 추가) — 실제로 쓰이는 곳은 .env/.env.local/.env.development/
# .env.production(전부 git 미추적)과, 예시 템플릿인 .env.example.
# 시크릿(NAVER_CLIENT_SECRET/TOSSPAYMENTS_SECRET_KEY/GOOGLE_CLIENT_SECRET)은 여기서도
# 빈 자리표시자로만 남김 — 어차피 노출돼도 되는 공개성 값(Client ID, 토스 클라이언트
# 키, 카카오/지도 JS 키)만 ecBeBo DB(sy_prop, ^local^dev^ 프로필)에서 확인한 실제
# 테스트값으로 채움.
NUXT_API_BASE_URL=https://22300.illeesam.synology.me
NUXT_PUBLIC_PROD_CDN_BASE=https://22400.illeesam.synology.me/api

NUXT_PUBLIC_TOSSPAYMENTS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
# TOSSPAYMENTS_SECRET_KEY=

GOOGLE_CLIENT_ID=207844440856-5ib9mk6frvt7rfpt8823e48c3c0lavth.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=jWtLT9SUfE2JWEji2XGq
# NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=a2990e41aa57c3a4ad1fe97a210938d7
# KAKAO_CLIENT_SECRET=

NUXT_PUBLIC_KAKAO_MAP_KEY=a2990e41aa57c3a4ad1fe97a210938d7
