# scripts/deploy-sites.mjs(= "netlify DEPLOY <site> github-push")가 로컬에서 읽는 배포용 설정.
# 이 파일을 복사해 저장소 루트에 ".env.deploy" 로 저장할 것 — 이 파일 자체는 .gitignore 처리되어 커밋되지 않는다.
# 값이 없으면 해당 기능(빌드결과 확인/이메일·텔레그램 통지)만 조용히 스킵되고 push 자체는 정상 진행된다.
#
# 표기 규칙(2026-09-27 현재값 기준): 비밀번호는 가운데 4자리를 ****, 토큰은 앞4·뒤4만 남기고 가렸습니다.
# ⚠ 이 .example 파일에 실제 비밀번호/토큰 원문을 채우지 마세요(저장소에 올라갑니다).

# Netlify 배포결과 확인용 — 없으면 push까지만 하고 "대시보드에서 직접 확인" 안내만 남김.
# 설정: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=nfp_****6695

# 배포 결과 이메일 통지 (선택) — 발신 Gmail 계정과 그 계정의 "앱 비밀번호"(일반 로그인 비밀번호 아님).
# 설정: https://myaccount.google.com/apppasswords
NOTIFY_EMAIL_FROM=illeesam4@gmail.com
NOTIFY_EMAIL_APP_PASSWORD=bbiutb****ntnmir
# 생략 시 기본값 illeesam@gmail.com 로 발송됨.
NOTIFY_EMAIL_TO=illeesam@gmail.com,illeesam4@gmail.com

# 텔레그램 알림(선택) — 로컬 배포 스크립트 결과를 oper 봇(shopjoy-apps-oper 그룹)으로 알리고 로그 파일도 첨부한다
TELEGRAM_BOT_TOKEN_OPER=8971****S7BA
TELEGRAM_CHAT_ID_OPER=-5581028759
